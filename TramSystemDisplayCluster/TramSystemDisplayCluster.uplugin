	"IsExperimentalVersion": false,
	"Installed": false,
	"Modules": [
		{
			"Name": "TramSystemDisplayCluster",
			"Type": "Runtime",
			"LoadingPhase": "Default"
		}
	],
	"Plugins": [
		{
			"Name": "TramSystem",
			"Enabled": true
		},
		{
			"Name": "nDisplay",
			"Enabled": true
		}
	]
}
